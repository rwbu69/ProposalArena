# ==============================================================================
# Vercel Presentation Mode Environment Variables
# Set these in your Vercel Project Dashboard (Settings -> Environment Variables)
# ==============================================================================

# Tells the frontend to route requests through the serverless proxy
PUBLIC_AI_PROXY_URL=/api/ai

# Server-Side API Secrets (NEVER prefix these with PUBLIC_)
# 1. Google Gemini Key (from https://aistudio.google.com/)
GEMINI_API_KEY=

# 2. Groq Key for Whisper STT (from https://console.groq.com/)
GROQ_API_KEY=

# Optional model override (defaults to gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

