---
import Dashboard from '../components/eval/Dashboard.svelte';
const title = 'Evaluation Dashboard - AI Thesis Simulator';
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body class="bg-slate-50 min-h-screen font-sans text-slate-900">
    <nav class="bg-white border-b border-slate-200 px-6 py-4 flex justify-between items-center">
      <h1 class="text-xl font-bold">Academic Evaluation Dashboard</h1>
      <a href="/" class="text-blue-600 hover:underline">Back to Simulator</a>
    </nav>
    <main class="p-6">
      <Dashboard client:only="svelte" />
    </main>
  </body>
</html>
