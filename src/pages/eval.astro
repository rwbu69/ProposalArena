---
import Dashboard from '../components/eval/Dashboard.svelte';
const title = 'Evaluation Dashboard - AI Thesis Simulator';
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Lora:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
    <title>{title}</title>
    <script is:inline>
      (function() {
        try {
          var t = localStorage.getItem('thesis-defense-simulator:theme');
          if (!t) {
            var s = localStorage.getItem('thesis-defense-simulator:settings');
            if (s) {
              try { t = JSON.parse(s).theme; } catch (e) {}
            }
          } else {
            try { t = JSON.parse(t); } catch (e) {}
          }
          var isDark = false;
          if (t === 'dark') {
            isDark = true;
          } else if (t === 'light') {
            isDark = false;
          } else {
            isDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          }
          if (isDark) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      })();
    </script>
    <style is:global>
      /* Clean, quiet scrollbar */
      .doc-scroll::-webkit-scrollbar {
        width: 4px;
      }
      .doc-scroll::-webkit-scrollbar-track {
        background: transparent;
      }
      .doc-scroll::-webkit-scrollbar-thumb {
        background-color: #dcdad2;
      }
      @media (prefers-color-scheme: dark) {
        .doc-scroll::-webkit-scrollbar-thumb {
          background-color: #33322f;
        }
      }
      /* Reading length */
      .prose-reading {
        max-width: 65ch;
      }
      /* Selection colors */
      ::selection {
        background-color: #e5e3dc;
        color: #181816;
      }
      @media (prefers-color-scheme: dark) {
        ::selection {
          background-color: #33322f;
          color: #ecebe6;
        }
      }
    </style>
  </head>
  <body class="bg-paper dark:bg-paper-dark min-h-screen font-sans text-ink dark:text-ink-dark antialiased">
    <nav class="border-b border-hairline dark:border-hairline-dark px-6 py-4 flex justify-between items-center bg-paper dark:bg-paper-dark">
      <h1 class="font-serif text-lg font-normal tracking-tight">Academic Evaluation Dashboard</h1>
      <a href="/" class="text-xs font-mono text-ink-muted hover:text-ink dark:hover:text-ink-dark transition-colors uppercase tracking-wider">← Simulator</a>
    </nav>
    <main class="p-6 sm:p-10">
      <Dashboard client:only="svelte" />
    </main>
  </body>
</html>
