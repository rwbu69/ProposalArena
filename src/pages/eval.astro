---
import Dashboard from '../components/eval/Dashboard.svelte';
const title = 'Evaluation Dashboard - AI Thesis Simulator';
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300;400;500;600&family=Lora:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    <title>{title}</title>
    <style is:global>
      /* Noise background texture */
      .noise-bg {
        position: absolute;
        inset: 0;
        opacity: 0.03;
        pointer-events: none;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
      }
      /* Custom scrollbar for document */
      .doc-scroll::-webkit-scrollbar {
        width: 4px;
      }
      .doc-scroll::-webkit-scrollbar-track {
        background: transparent;
      }
      .doc-scroll::-webkit-scrollbar-thumb {
        background-color: #333;
        border-radius: 10px;
      }
      /* Optimal reading length for prose */
      .prose-reading {
        max-width: 65ch;
      }
      /* Selection colors */
      ::selection {
        background-color: #e6e6e6;
        color: #121212;
      }
      /* Autofill styling override */
      input:-webkit-autofill {
        -webkit-box-shadow: 0 0 0px 1000px transparent inset;
        -webkit-text-fill-color: inherit;
        transition: background-color 5000s ease-in-out 0s;
      }
    </style>
  </head>
  <body class="bg-white dark:bg-space-left min-h-screen font-sans text-black dark:text-white">
    <nav class="bg-white border-b border-slate-200 px-6 py-4 flex justify-between items-center">
      <h1 class="text-xl font-bold">Academic Evaluation Dashboard</h1>
      <a href="/" class="text-blue-600 hover:underline">Back to Simulator</a>
    </nav>
    <main class="p-6">
      <Dashboard client:only="svelte" />
    </main>
  </body>
</html>
