---
import ReportViewer from '../components/interview/ReportViewer.svelte';
const title = 'Bimbingan & Refleksi Sidang | Proposal Arena';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Lora:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
    <title>{title}</title>
    <script is:inline>
      (function() {
        try {
          var t = localStorage.getItem('thesis-defense-simulator:theme');
          if (!t) {
            var s = localStorage.getItem('thesis-defense-simulator:settings');
            if (s) {
              try { t = JSON.parse(s).theme; } catch (e) {}
            }
          } else {
            try { t = JSON.parse(t); } catch (e) {}
          }
          var isDark = false;
          if (t === 'dark') {
            isDark = true;
          } else if (t === 'light') {
            isDark = false;
          } else {
            isDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          }
          if (isDark) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      })();
    </script>
    <style is:global>
      /* Clean, quiet scrollbar */
      .doc-scroll::-webkit-scrollbar {
        width: 4px;
      }
      .doc-scroll::-webkit-scrollbar-track {
        background: transparent;
      }
      .doc-scroll::-webkit-scrollbar-thumb {
        background-color: #dcdad2;
      }
      @media (prefers-color-scheme: dark) {
        .doc-scroll::-webkit-scrollbar-thumb {
          background-color: #33322f;
        }
      }
      /* Reading length */
      .prose-reading {
        max-width: 65ch;
      }
      /* Selection colors */
      ::selection {
        background-color: #e5e3dc;
        color: #181816;
      }
      @media (prefers-color-scheme: dark) {
        ::selection {
          background-color: #33322f;
          color: #ecebe6;
        }
      }
      /* Autofill styling override */
      input:-webkit-autofill {
        -webkit-box-shadow: 0 0 0px 1000px transparent inset;
        -webkit-text-fill-color: inherit;
        transition: background-color 5000s ease-in-out 0s;
      }
      /* Print styles */
      @media print {
        .no-print {
          display: none !important;
        }
        body {
          background: #ffffff !important;
          color: #000000 !important;
        }
        .print-break-inside-avoid {
          break-inside: avoid;
          page-break-inside: avoid;
        }
      }
    </style>
  </head>
  <body class="bg-paper dark:bg-paper-dark text-ink dark:text-ink-dark min-h-screen antialiased">
    <ReportViewer client:only="svelte" />
  </body>
</html>
